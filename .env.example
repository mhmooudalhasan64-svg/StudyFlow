# تُضبط هذه المتغيرات في Vercel: Project → Settings → Environment Variables
# (أو في ملف .env.local عند التجربة المحلية، وهو غير مرفوع إلى GitHub)
# يكفي مفتاح واحد فقط. يُستخدم أول مفتاح موجود بهذا الترتيب:
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
# اختياري
AI_MODEL=
CHAT_DAILY_LIMIT=30

# موصى به للإنتاج: حد يومي موزّع بين جميع نسخ Vercel عبر Upstash Redis REST
# إذا ضُبط أحد المتغيرين فقط أو تعطلت الخدمة، يرفض API الطلبات مؤقتاً بدلاً من الرجوع إلى حد محلي.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
