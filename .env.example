# Server-side DALIL provider configuration for MASAR. Never expose secrets to the browser.
# Gemini is the primary free engine; OpenAI is used only after explicit student consent.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Daily per-IP request limit for DALIL inside MASAR.
CHAT_DAILY_LIMIT=30
# Keep this legacy variable name: the deployed API still reads it.
VAYORA_ALLOWED_ORIGINS=

# Railway Redis is used for shared rate limiting.
REDIS_URL=
