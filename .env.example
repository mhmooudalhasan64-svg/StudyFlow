# متغيرات خادم SKOVA (تُضبط في Railway للخادم أو .env.local محلياً).
# في المعاينة الحالية تمر طلبات الواجهة إلى Railway عبر VITE_API_BASE_URL.
# يكفي مفتاح صالح واحد فقط؛ يُستخدم أول مفتاح موجود بهذا الترتيب:
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=

# اختياري
AI_MODEL=
CHAT_DAILY_LIMIT=30
VAYORA_ALLOWED_ORIGINS=

# حد يومي موزّع عبر Upstash عند تشغيل API على Vercel مباشرة.
# على Railway يُستخدم REDIS_URL المرتبط بخدمة Redis في المشروع.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
