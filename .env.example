# Server-side AVORA provider configuration. Never expose secrets to the browser.
# OpenRouter free-only routing is enforced in the API (openrouter/free).
# Add the API key only as a Railway secret; do not commit it or send it in chat.
OPENROUTER_API_KEY=

# Daily per-IP limit in the VAYORA backend. OpenRouter free models also have
# an account-wide cap (currently 50 requests/day, 20 requests/minute).
CHAT_DAILY_LIMIT=30
VAYORA_ALLOWED_ORIGINS=

# Railway Redis is used for shared rate limiting.
REDIS_URL=
