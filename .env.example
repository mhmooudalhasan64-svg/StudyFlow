# Server-side AVORA provider configuration. Never expose secrets to the browser.
# Groq is the primary provider; OpenRouter is an optional fallback.
GROQ_API_KEY=
OPENROUTER_API_KEY=
# OpenAI is only used after explicit student consent for additional usage.
OPENAI_API_KEY=

# Daily per-IP request limit for AVORA.
CHAT_DAILY_LIMIT=30
VAYORA_ALLOWED_ORIGINS=

# Railway Redis is used for shared rate limiting. Same-origin web requests are allowed automatically;
# add extra trusted web origins here only when the API is called cross-origin.
REDIS_URL=
