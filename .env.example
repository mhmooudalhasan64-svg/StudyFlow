# Server-side AVORA provider configuration. Never expose secrets to the browser.
# Gemini is the primary free engine; OpenAI is used only after explicit student consent.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Daily per-IP request limit for AVORA.
CHAT_DAILY_LIMIT=30
VAYORA_ALLOWED_ORIGINS=

# Railway Redis is used for shared rate limiting.
REDIS_URL=
