# Server-side AI provider configuration. Never expose secrets to browser or mobile clients.
# The current API route accepts OpenRouter and pins requests to openrouter/free.
OPENROUTER_API_KEY=

# Daily per-IP request limit enforced by api/chat.ts.
CHAT_DAILY_LIMIT=30

# Comma-separated exact web origins allowed to call the API.
# Native Capacitor origins are separately allowlisted in the API handler.
VAYORA_ALLOWED_ORIGINS=

# Vercel deployment: configure BOTH Upstash REST values for shared rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional Railway Node-server deployment: use REDIS_URL instead of Upstash REST.
# Do not configure partial Redis credentials; production fails closed without a shared limiter.
REDIS_URL=
